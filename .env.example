# Aplicação
APP_NAME=DevFlow
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_VERSION=1.0.0

# Banco de dados
DB_HOST=db
DB_PORT=3306
DB_DATABASE=devflow
DB_USERNAME=devflow
DB_PASSWORD=devflow_pass

# MySQL root (apenas Docker)
MYSQL_ROOT_PASSWORD=root_pass_change_me

# Resend API (https://resend.com)
# Deixe vazio ou MAIL_ENABLED=false para desabilitar o envio real
RESEND_API_KEY=
MAIL_FROM=noreply@seudominio.com
MAIL_FROM_NAME=DevFlow
MAIL_ENABLED=false

# Admin (para GET /api/leads)
# Gere com: openssl rand -hex 32
ADMIN_TOKEN=troque_este_token_antes_de_usar

# Criptografia de dados pessoais (LGPD)
# Gere com: openssl rand -hex 32
# exemplo
ENCRYPTION_KEY=009568a8f9398456d1f92111a0ef65ee5aeba525845b69d8752f10d9903ec07c
ENCRYPTION_HMAC_KEY=fa76d2c612fbf358b07c09163ff01ac521f72e6316e310c98697b284b357ea80
